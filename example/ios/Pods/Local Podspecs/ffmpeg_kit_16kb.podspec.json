{
  "name": "ffmpeg_kit_16kb",
  "version": "1.0.0",
  "summary": "FFmpeg Kit for Flutter",
  "description": "A Flutter plugin for running FFmpeg and FFprobe commands.",
  "homepage": "https://github.com/sk3llo/ffmpeg_kit_flutter",
  "license": {
    "file": "../LICENSE"
  },
  "authors": {
    "AK": "kapraton@gmail.com"
  },
  "platforms": {
    "ios": null
  },
  "requires_arc": true,
  "static_framework": true,
  "source": {
    "path": "."
  },
  "source_files": "Classes/**/*",
  "public_header_files": "Classes/**/*.h",
  "default_subspecs": "full-gpl-lts",
  "dependencies": {
    "Flutter": [

    ]
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386 arm64"
  },
  "prepare_command": "if [ ! -d \"./Frameworks\" ]; then\n  chmod +x ../scripts/setup_ios.sh\n  ../scripts/setup_ios.sh\n  fi",
  "subspecs": [
    {
      "name": "min",
      "source_files": "Classes/**/*",
      "public_header_files": "Classes/**/*.h",
      "dependencies": {
        "ffmpeg-kit-ios-min": [
          "5.1"
        ]
      },
      "platforms": {
        "ios": "14.0"
      }
    },
    {
      "name": "min-lts",
      "source_files": "Classes/**/*",
      "public_header_files": "Classes/**/*.h",
      "dependencies": {
        "ffmpeg-kit-ios-min": [
          "5.1.LTS"
        ]
      },
      "platforms": {
        "ios": "14.0"
      }
    },
    {
      "name": "min-gpl",
      "source_files": "Classes/**/*",
      "public_header_files": "Classes/**/*.h",
